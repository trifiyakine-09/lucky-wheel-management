@startuml architecture
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
left to right direction
skinparam rectangle {
  BackgroundColor #FFF8EF
  BorderColor #7A5C2E
}
skinparam database {
  BackgroundColor #FFF8EF
  BorderColor #7A5C2E
}

actor "Administrateur" as user
rectangle "Client\n(Navigateur)\n--\nAngular SPA" as front
rectangle "Serveur d'application\n--\nAPI REST Laravel" as back
database "Base de données\n--\nMySQL" as db

user --> front : Utilise
front <--> back : Requêtes HTTP\n(JSON)
back <--> db : Requêtes SQL\n(Eloquent ORM)
@enduml
